# systemd *user* unit: starts UniversalV1 full screen when user jetson's
# desktop session comes up (GDM autologin). Template: install it with
#   ./deploy/install-autostart.sh --now
# which replaces @REPO@ with this repository's path.
#
# No DISPLAY line on purpose: the X display number can change between boots
# (:0 / :1) and GNOME imports the right DISPLAY/XAUTHORITY into the user
# manager before graphical-session.target is reached.

[Unit]
Description=UniversalV1 vision inspection (kiosk)
After=graphical-session.target
PartOf=graphical-session.target
# Stop retrying after 10 crashes in 5 minutes instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python3 @REPO@/main.py
Environment=QT_QPA_PLATFORM=xcb
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
